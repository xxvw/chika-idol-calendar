{
  "name": "chika-idol-calendar",
  "version": "0.0.0",
  "private": true,
  "description": "複数の地下アイドルの予定をまとめて確認するカレンダーアプリ",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "wrangler dev --env staging",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "types": "wrangler types",
    "types:check": "wrangler types --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:test": "supabase test db",
    "db:types": "node scripts/check-database-types.mjs --write",
    "db:types:check": "node scripts/check-database-types.mjs",
    "db:benchmark:ci": "node scripts/db-benchmark.mjs --profile=ci",
    "db:benchmark:medium": "node scripts/db-benchmark.mjs --profile=medium --output=docs/db/results/medium.json",
    "db:benchmark:large": "node scripts/db-benchmark.mjs --profile=large --output=docs/db/results/large.json",
    "deploy:dry-run:staging": "wrangler deploy --env staging --dry-run",
    "deploy:dry-run:production": "wrangler deploy --env production --dry-run",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "terraform:check": "terraform fmt -check -recursive infra && terraform -chdir=infra/environments/staging init -backend=false && terraform -chdir=infra/environments/staging validate && terraform -chdir=infra/environments/production init -backend=false && terraform -chdir=infra/environments/production validate",
    "check": "npm run format:check && npm run lint && npm run types:check && npm run typecheck && npm run test && npm run deploy:dry-run:staging && npm run deploy:dry-run:production && npm run terraform:check"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.21.3",
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "@types/pg": "8.15.5",
    "eslint": "10.8.1",
    "pg": "8.16.3",
    "prettier": "3.9.6",
    "supabase": "2.114.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10",
    "wrangler": "4.123.0"
  }
}
